# Parameters of infra/main.bicep for staging (read by main.bicepparam through provision.yml).
# Secrets (POSTGRESQL_ADMIN_PASSWORD…) and people (ALERT_EMAILS, POSTGRESQL_ENTRA_ADMIN_*) come
# from the 1Password note tekad-frais-infra.staging.provision.
AZURE_ENV_NAME=staging
AZURE_RESOURCE_TOKEN=tekad-frais-staging
AZURE_LOCATION=switzerlandnorth
AZURE_STATIC_WEB_APP_LOCATION=westeurope
# The shared Neuralis server, like the other staging environments: Provision creates the
# database tekad on it.
POSTGRESQL_EXISTING_SERVER_ID=/subscriptions/d2bb70e2-0cfd-4d75-b5a2-169ee1b74203/resourceGroups/rg-neuralis-commons/providers/Microsoft.DBforPostgreSQL/flexibleServers/pg-neuralis-shared
FUNCTION_ALWAYS_READY_INSTANCES=0
FUNCTION_MAXIMUM_INSTANCE_COUNT=5
# Empty until the CNAME tekad-frais.neuralis.dev → <static web app host> exists (docs/DEPLOYMENT.md).
CUSTOM_DOMAINS=
PUBLIC_BASE_URL=https://tekad-frais.neuralis.dev
LOG_RETENTION_DAYS=30
LOG_DAILY_QUOTA_GB=1
