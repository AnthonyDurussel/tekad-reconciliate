# Parameters of infra/main.bicep for production (read by main.bicepparam through provision.yml).
# Secrets (POSTGRESQL_ADMIN_PASSWORD…) and people (ALERT_EMAILS, POSTGRESQL_ENTRA_ADMIN_*) come
# from the 1Password note tekad-frais-infra.production.provision.
AZURE_ENV_NAME=production
AZURE_RESOURCE_TOKEN=tekad-frais
AZURE_LOCATION=switzerlandnorth
AZURE_STATIC_WEB_APP_LOCATION=westeurope
POSTGRESQL_SKU_NAME=Standard_B1ms
POSTGRESQL_TIER=Burstable
POSTGRESQL_BACKUP_RETENTION_DAYS=35
POSTGRESQL_GEO_REDUNDANT_BACKUP=Enabled
# A few dozen users, office hours: no instance kept warm.
FUNCTION_ALWAYS_READY_INSTANCES=0
FUNCTION_MAXIMUM_INSTANCE_COUNT=5
# Empty until the CNAME frais.tekad.ch → <static web app host> exists (docs/DEPLOYMENT.md).
CUSTOM_DOMAINS=
PUBLIC_BASE_URL=https://frais.tekad.ch
LOG_RETENTION_DAYS=90
LOG_DAILY_QUOTA_GB=1
