{
  "name": "api",
  "version": "0.1.0",
  "description": "Tekad — réconciliation des frais Revolut / UBS / bexio (Azure Functions)",
  "type": "module",
  "main": "dist/index.cjs",
  "scripts": {
    "build": "pnpm run build:api && pnpm run build:scripts",
    "watch": "esbuild --watch=forever src/index.ts --outdir=dist --bundle --platform=node --external:@azure/functions-core --format=cjs --define:__dirname=__dirname --define:__BACKEND_VERSION__=\\\"$npm_package_version\\\" --target=node20 --sourcemap --out-extension:.js=.cjs &",
    "clean": "rimraf dist",
    "prestart": "pnpm run clean && pnpm run build",
    "start": "func start",
    "dev": "pnpm run watch && pnpm run start",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "eslint": "eslint .",
    "eslint:fix": "eslint . --fix",
    "lint": "pnpm run eslint:fix",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "migrate": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "prisma:reset": "prisma migrate reset",
    "seed": "tsx ./scripts/seed.ts",
    "build:api": "esbuild src/index.ts --outdir=dist --bundle --platform=node --external:@azure/functions-core --format=cjs --define:__dirname=__dirname --define:__BACKEND_VERSION__=\\\"$npm_package_version\\\" --target=node20 --out-extension:.js=.cjs --minify --sourcemap",
    "build:scripts": "esbuild scripts/ensure-admin.ts scripts/seed.ts --outdir=dist --bundle --platform=node --external:@azure/functions-core --format=cjs --define:__dirname=__dirname --define:__BACKEND_VERSION__=\\\"$npm_package_version\\\" --target=node20 --out-extension:.js=.cjs",
    "package": "node scripts/package-function.mjs",
    "prepare-release": "pnpm run build && pnpm run package",
    "dev:server": "tsx ./scripts/dev-server.ts"
  },
  "dependencies": {
    "@azure/communication-email": "^1.1.0",
    "@azure/core-auth": "^1.10.1",
    "@azure/functions": "^4.17.1",
    "@azure/identity": "^4.13.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@repo/models": "workspace:*",
    "dotenv": "^18.0.10",
    "exceljs": "^4.4.0",
    "inversify": "^8.3.0",
    "pdf-lib": "^1.17.1",
    "reflect-metadata": "^0.2.2",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.15.5",
    "@typescript-eslint/eslint-plugin": "^8.73.0",
    "@typescript-eslint/parser": "^8.73.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-unused-imports": "^4.4.1",
    "prettier": "^3.10.1",
    "prisma": "7.10.1",
    "rimraf": "^6.1.4",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  }
}
