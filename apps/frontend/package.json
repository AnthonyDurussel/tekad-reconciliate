{
  "name": "frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "lint": "pnpm run prettier:write && pnpm run eslint:fix",
    "prettier": "prettier --check src",
    "prettier:write": "prettier --write src mock",
    "eslint": "eslint src",
    "eslint:fix": "eslint src --fix",
    "vitest": "vitest run",
    "vitest:watch": "vitest",
    "check-i18n": "node ./check-translations.js",
    "test": "pnpm run typecheck && pnpm run eslint && pnpm run vitest && pnpm run build",
    "package": "tar -czf frontend-dist.tar.gz -C dist .",
    "prepare-release": "pnpm run build && pnpm run package"
  },
  "dependencies": {
    "@mantine/charts": "^9.8.1",
    "@mantine/core": "^9.8.1",
    "@mantine/dates": "^9.8.1",
    "@mantine/form": "^9.8.1",
    "@mantine/hooks": "^9.8.1",
    "@mantine/modals": "^9.8.1",
    "@mantine/notifications": "^9.8.1",
    "@reduxjs/toolkit": "^2.14.0",
    "@repo/models": "workspace:*",
    "@tabler/icons-react": "^3.52.0",
    "dayjs": "^1.11.18",
    "echarts": "6.1.0",
    "i18next": "^26.6.0",
    "mantine-form-yup-resolver": "^2.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^17.1.10",
    "react-redux": "^9.2.0",
    "react-router-dom": "^7.18.3",
    "recharts": "^3.10.1",
    "redux": "^5.0.1",
    "redux-persist": "^6.0.0",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^5.30.3",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.12",
    "@types/node": "^26.6.6",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "@typescript-eslint/eslint-plugin": "^8.73.0",
    "@typescript-eslint/parser": "^8.73.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.14.0",
    "jsdom": "30.1.3",
    "postcss": "^8.5.33",
    "postcss-preset-mantine": "1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vite-plugin-mock-dev-server": "^2.7.1",
    "vitest": "^5.1.0"
  }
}
